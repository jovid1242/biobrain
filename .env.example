# BioBrain environment. Copy to .env (never commit .env). Nothing here is required for Milestone 1.

# RAM ceiling for heavy steps; binary units (8GB = 8 GiB). The CLI flag --memory-budget overrides it.
BIOBRAIN_MEMORY_BUDGET=8GB

# Optional location overrides (defaults: ./data and ./results inside the project).
# BIOBRAIN_DATA_DIR=/Volumes/external/biobrain-data
# BIOBRAIN_RESULTS_DIR=./results

# Not used yet. Only needed if a later milestone reads login-gated products:
# FlyWire Codex downloads (Google sign-in -> api_token), e.g. the post-783 "Princeton synapses".
# CODEX_API_TOKEN=
# FlyWire CAVE (live materialization queries).
# CAVE_TOKEN=
